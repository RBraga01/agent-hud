# Local development and agent tooling. These folders can contain prompts,
# transcripts, session indexes, tool databases and machine-specific paths.
.claude/
.codex/
.agent-hud/
.opencode/
.cursor/
.continue/
.windsurf/
.aider*
.agent-sync/
skills/
hooks/
scripts/
templates/
INIT.md
TEAM.md
.metrics/
.sessions/
sessions/
transcripts/

# Raven Framework — a separate proprietary dependency, installed by hand.
# See the README. Never commit it here.
raven-framework/

# Brilliant Labs SDK — public, but kept as a pinned local dependency rather
# than copied into Agent HUD.
platforms/halo/vendor/brilliant_sdk/
platforms/halo/artifacts/

# Internal planning notes, kept outside the repository
docs/specs/
docs/plans/

# Secrets and local settings
.env*
!.env.example
agents.local.json
credentials*.json
passkeys*.json
secrets*.json
tokens*.json

# Local databases, logs, certificates and private keys. The application reads
# these from outside the repository; tests create temporary copies under pytest.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
*.key
*.pem
*.p12
*.pfx
gateway-cert.*
id_rsa*
id_ed25519*

# Runtime output from the Raven framework's logger
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
