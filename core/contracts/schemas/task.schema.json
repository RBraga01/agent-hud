{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent HUD M0 Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "revision",
    "actions"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "label"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          }
        }
      }
    }
  }
}
