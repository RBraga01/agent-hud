{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent HUD Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "task_id",
    "revision",
    "action_id"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "payload": {
      "type": "object"
    }
  }
}
