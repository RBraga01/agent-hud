{
  "id": "io.agenthud.memomind",
  "name": "Agent HUD",
  "version": "0.1.0",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "permissions": [
    {
      "name": "device.events",
      "required": true,
      "scope": { "types": ["connection"] }
    },
    {
      "name": "device.info",
      "required": true
    },
    {
      "name": "device.messaging",
      "required": true,
      "scope": { "channels": [16712, 16713] }
    }
  ],
  "deviceRequirements": {
    "preferredPluginId": "io.agenthud.memomind",
    "requiredPluginId": "io.agenthud.memomind",
    "minPluginVersion": "1",
    "protocols": [
      { "id": "agent-hud.decision", "minVersion": "1.0" }
    ]
  },
  "schemaVersion": 2,
  "permissionPolicyVersion": 1
}
