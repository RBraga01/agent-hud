# Copy to .env and edit. .env is ignored by git and must stay that way.
# Both settings are optional; the defaults below are what the app uses.

# Where to ask for the list of items.
AGENT_HUD_GATEWAY_URL=http://127.0.0.1:8765/items

# How often to ask, in seconds. Must be greater than zero.
AGENT_HUD_POLL_SECONDS=3

# Port for the development stub gateway.
AGENT_HUD_PORT=8765

# Which sources to read, in order. Any of: simulated, claude, file
# The default invents everything, so it needs no accounts and reveals
# nothing personal.
AGENT_HUD_FEEDERS=simulated

# Show the last thing you asked Claude on the display. Off on purpose:
# it is your own writing, and it would pass through a file on disk.
# AGENT_HUD_SHOW_PROMPTS=1

# Where to look for Claude Code sessions.
# AGENT_HUD_CLAUDE_PROJECTS=~/.claude/projects
