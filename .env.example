# A reference for every setting the app reads. This file is NOT loaded
# automatically — there is no dotenv dependency. Export the values you want
# into your shell, or wrap main.py in a script that does.
#
#   export AGENT_HUD_FEEDERS=claude,simulated        # macOS / Linux
#   $env:AGENT_HUD_FEEDERS = "claude,simulated"      # Windows PowerShell
#
# Every setting is optional. The values shown are the defaults.

# Where to ask for the list of items.
AGENT_HUD_GATEWAY_URL=http://127.0.0.1:8765/items

# How often to ask, in seconds. Must be a finite number greater than zero.
AGENT_HUD_POLL_SECONDS=3

# Port for the development stub gateway.
AGENT_HUD_PORT=8765

# Which sources to read, in order. Any of: simulated, claude, file
# The default invents everything, so it needs no accounts and reveals
# nothing personal.
AGENT_HUD_FEEDERS=simulated

# Show the last thing you asked Claude on the display. Off on purpose:
# it is your own writing, and it would pass through a file on disk.
# AGENT_HUD_SHOW_PROMPTS=1

# Where the 'claude' feeder looks for session transcripts.
# AGENT_HUD_CLAUDE_PROJECTS=~/.claude/projects

# Where the 'claude_hook' feeder and the two Claude Code hooks read/write
# session state. See integrations/claude_code/ for the four hook scripts.
# AGENT_HUD_CLAUDE_STATE=~/.agent-hud/claude

# Extra folder names to ignore when naming a project from its path.
# Common ones (projects, code, src, repos, ...) are handled already.
# AGENT_HUD_SKIP_PATH_WORDS=acme,internal

# Raven deployment credentials. Only needed for `python main.py deploy`,
# and only if you have been issued them by Raven Resonance.
# RAVEN_APP_ID=
# RAVEN_APP_KEY=
